# Laction Agent — contoh environment variable
# Copy ke `.env` lalu isi sesuai provider kamu. `.env` dibaca otomatis
# (tanpa python-dotenv); environment proses tetap menang atas isi .env.

# Provider: mock (demo tanpa API key) | openai | openrouter | ollama | nous | custom
LACTION_PROVIDER=mock

# Untuk OpenAI / OpenRouter / Nous Portal / endpoint OpenAI-compatible lain
LACTION_API_KEY=sk-xxxx
LACTION_API_BASE=https://api.openai.com/v1
LACTION_MODEL=gpt-4o-mini

# Untuk Ollama lokal
# LACTION_PROVIDER=ollama
# LACTION_API_BASE=http://localhost:11434/v1
# LACTION_MODEL=llama3.1

# Direktori data / profil (memory, sessions, skills, cron)
# Ganti nilai ini untuk isolasi profil ala HERMES_HOME
LACTION_HOME=./data

# Loop & konteks
LACTION_MAX_ITERATIONS=10
LACTION_CONTEXT_LIMIT=8000

# Keamanan terminal: smart | always | never
LACTION_APPROVAL_MODE=smart

# Scheduler cron (1/true/yes/on atau 0/false/no/off)
LACTION_CRON_ENABLED=true

# Opsional: izinkan web_fetch ke alamat privat (default: diblokir / SSRF guard)
# Hanya untuk dev lokal yang memang disengaja
# LACTION_ALLOW_PRIVATE_WEB=1

# Opsional: path config.yaml & token gateway
# LACTION_CONFIG=./config.yaml
# LACTION_GATEWAY_TOKEN=rahasia-token-kamu
# LACTION_GATEWAY_PORT=8000
