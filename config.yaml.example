# Laction Agent — contoh config
# Copy ke config.yaml untuk override. Semua field opsional.
# Urutan prioritas: env proses > .env > config.yaml > default.

provider: mock
model: mock-laction-1
api_base: ""
api_key: ""

home: ./data
workspace: ""
max_iterations: 10
context_limit: 8000
team_timeout_seconds: 45

# Persetujuan eksekusi:
# - smart / always : run_terminal, run_python, create_skill, dan mcp_call meminta approval eksplisit
# - never          : blokir seluruh eksekusi shell, Python, skill baru, dan MCP eksternal
approval_mode: smart

# Backend isolasi opsional (none | auto | docker)
sandbox_mode: none
docker_image: python:3.11-slim

# Cron scheduler (dipakai oleh `laction gateway` / `laction cron start`)
cron_enabled: true
